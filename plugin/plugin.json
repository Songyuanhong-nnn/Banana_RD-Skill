{
  "$schema": "https://ai-sq.local/schemas/plugin.json",
  "name": "ai-sq-universal-root-inquiry",
  "displayName": "AI-SQ Universal Root-Inquiry / 通用求根问底调研",
  "version": "2.4.0",
  "kind": "skill-bundle",
  "description": "通用求根问底调研内核：14 维问题面总纲 × 九层追问链 × 因素空间（9 轴/量级/交互/分层）× 覆盖饱和 × 引用到句 × 结构化报告；7 个领域包，细菌致病性为 science 子包；含诚实的领域适配度矩阵与两轮遗漏审计。",
  "author": "AI-SQ",
  "license": "MIT",
  "homepage": "https://ai-sq.local/ai-sq-universal-root-inquiry",
  "keywords": [
    "research",
    "root-cause",
    "evidence-chain",
    "question-tree",
    "调研",
    "求根问底",
    "证据链"
  ],
  "requires": {
    "dsh": ">=0.2.0",
    "plugins": [
      "@deepseek-ai/dsh-skill",
      "@deepseek-ai/dsh-skill-filesystem"
    ],
    "python": ">=3.8",
    "pythonPackages": ["pyyaml"]
  },
  "contributes": {
    "skills": [
      {
        "name": "ai-sq-universal-root-inquiry",
        "path": "../ai-sq-universal",
        "entry": "SKILL.md",
        "frontmatterName": "ai-sq-universal-root-inquiry"
      }
    ],
    "config": "cordis.patch.yml"
  },
  "surface": {
    "prompts": 9,
    "schemas": 6,
    "references": 5,
    "domainPacks": 7,
    "subPacks": ["science.bacteriology"],
    "templates": 1,
    "evalCases": 13,
    "docx": "scripts/build_docx.py",
    "examples": 5,
    "scripts": ["scripts/validate.py", "scripts/quality_gate.py", "scripts/build_docx.py"]
  },
  "install": {
    "windows": "install.ps1",
    "unix": "install.sh",
    "defaultMode": "copy",
    "modes": {
      "copy": "复制到 ~/.dsh/skills/ai-sq-universal（默认用户技能根，无需改配置）",
      "plugin": "生成 Cordis 补丁，把本包所在目录注册为额外技能根（技能留在仓库原地，不复制）",
      "verify": "自检：frontmatter、文件布局、领域包、评测集"
    }
  },
  "risk": {
    "highRiskDomains": ["medicine", "law", "finance", "security", "policy", "psychology"],
    "requiresDisclaimer": true,
    "requiresHumanReview": true,
    "notes": "医学/法律/金融/安全/政策/心理领域输出必须带免责声明与人工复核建议；不提供可用于实际危害操作的可执行细节。"
  }
}
